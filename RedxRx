local noclipEnabled = false

local function updateNoclipUI()
    if noclipEnabled then
        noclipBtnFull.Text = "Noclip: ON"
        noclipBtnFull.BackgroundColor3 = Color3.fromRGB(0, 150, 0)
        noclipBtnMini.Text = "Noclip: ON"
        noclipBtnMini.BackgroundColor3 = Color3.fromRGB(0, 150, 0)
    else
        noclipBtnFull.Text = "Noclip: OFF"
        noclipBtnFull.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
        noclipBtnMini.Text = "Noclip: OFF"
        noclipBtnMini.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
    end
end

local function toggleNoclip()
    noclipEnabled = not noclipEnabled
    updateNoclipUI()
end

noclipBtnFull.MouseButton1Click:Connect(toggleNoclip)
noclipBtnMini.MouseButton1Click:Connect(toggleNoclip)

RunService.Stepped:Connect(function()
    if noclipEnabled and player.Character then
        for _, part in pairs(player.Character:GetDescendants()) do
            if part:IsA("BasePart") and part.CanCollide == true then
                part.CanCollide = false
            end
        end
    end
end)

