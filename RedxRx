-- 8) الطيران
-- ═══════════════════════════════════════
local flying = false
local bodyVelocity, bodyGyro

local function toggleFly()
    flying = not flying
    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end

    if flying then
        hum.PlatformStand = true
        bodyVelocity = Instance.new("BodyVelocity")
        bodyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        bodyVelocity.Velocity = Vector3.zero
        bodyVelocity.Parent = hrp
        
        bodyGyro = Instance.new("BodyGyro")
        bodyGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
        bodyGyro.P = 3000
        bodyGyro.D = 100
        bodyGyro.CFrame = hrp.CFrame
        bodyGyro.Parent = hrp
        
        flyBtnFull.Text = "إيقاف الطيران 🛑"
        flyBtnFull.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
        flyBtnMini.Text = "STOP"
        flyBtnMini.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
    else
        hum.PlatformStand = false
        if bodyVelocity then bodyVelocity:Destroy() end
        if bodyGyro then bodyGyro:Destroy() end
        flyBtnFull.Text = "تفعيل الطيران ✈️"
        flyBtnFull.BackgroundColor3 = Color3.fromRGB(80, 0, 0)
        flyBtnMini.Text = "FLY"
        flyBtnMini.BackgroundColor3 = Color3.fromRGB(80, 0, 0)
    end
end

flyBtnFull.MouseButton1Click:Connect(toggleFly)
flyBtnMini.MouseButton1Click:Connect(toggleFly)

-- 🌟 التعديل الجديد: حركة طيران مبنية على اتجاه الكاميرا (لو بصيت فوق يطلع فوق، ولو بصيت تحت ينزل تحت) 🌟
RunService.RenderStepped:Connect(function()
    if flying and bodyVelocity and bodyGyro then
        local char = player.Character
        if not char then return end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum then return end
        
        local moveDir = hum.MoveDirection
        local velocity = Vector3.zero
        
        if moveDir.Magnitude > 0 then
            local camLook = camera.CFrame.LookVector
            local camRight = camera.CFrame.RightVector
            
            -- بنشوف اتجاه العصا بالنسبة للكاميرا
            local flatLook = Vector3.new(camLook.X, 0, camLook.Z).Unit
            local forwardInput = moveDir:Dot(flatLook)
            local rightInput = moveDir:Dot(camRight)
            
            -- السحر كله هنا: دمجنا اتجاه نظرك (Y) مع اتجاه حركتك عشان يطير في نفس الاتجاه اللي بتبصله
            velocity = (camLook * forwardInput + camRight * rightInput).Unit * currentFlySpeed
        end
        
        -- دعم أزرار الكيبورد لو حد بيلعب على كمبيوتر
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
            velocity = velocity - Vector3.new(0, currentFlySpeed, 0) 
        elseif UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then
            velocity = velocity + Vector3.new(0, currentFlySpeed, 0)
        end
        
        bodyVelocity.Velocity = velocity
        bodyGyro.CFrame = camera.CFrame
    end
end)

